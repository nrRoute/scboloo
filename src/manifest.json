{
  "manifest_version": 3,
  "name": "Scboloo",
  "description": "easy way to post webpage to scrapbox.io",
  "author": "pastak",
  "version": "1.0.1",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "scboloo@pastak.net",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": ["main.js"],
    "service_worker": "main.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "options_ui": {
    "page": "option/option.html"
  },
  "action": {
    "default_popup": "/popup/popup.html"
  }
}
